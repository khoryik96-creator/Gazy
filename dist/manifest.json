{
  "manifest_version": 3,
  "name": "Gazy — LinkedIn Profile Finder",
  "version": "1.23.0",
  "description": "Extract LinkedIn profile URLs, score them against job descriptions, and export results.",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "clipboard-write"],
  "host_permissions": ["https://www.linkedin.com/*", "https://api.deepseek.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/people/*"],
      "js": ["content/extractor.js", "content/autoscroll.js", "content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
