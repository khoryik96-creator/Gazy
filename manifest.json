{
  "manifest_version": 3,
  "name": "LinkedIn Profile Finder",
  "version": "1.1.0",
  "description": "Extract LinkedIn profile URLs, score them against job descriptions, and export results.",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "clipboard-write"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/people/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
